{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:pyodide": "vitest run tests/pyodide",
    "test:int": "vitest run tests/integration",
    "gen:types": "supabase gen types typescript --local --schema public --workdir .. > lib/supabase/database.types.ts",
    "sync:learn": "node scripts/sync-learn.mjs",
    "sync:docs": "node scripts/sync-docs.mjs",
    "sync:starter": "node scripts/sync-starter.mjs",
    "predev": "npm run sync:learn && npm run sync:docs && npm run sync:starter",
    "prebuild": "npm run sync:learn && npm run sync:docs && npm run sync:starter",
    "pretypecheck": "npm run sync:learn && npm run sync:docs",
    "prelint": "npm run sync:learn && npm run sync:docs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "animejs": "^4.5.0",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "katex": "^0.19.0",
    "lenis": "^1.3.26",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "github-slugger": "^2.0.0",
    "happy-dom": "^21.0.1",
    "pyodide": "314.0.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
